{"_id":"TrMacRollComp01X","name":"Roll: The Company","type":"script","img":"icons/svg/d10-grey.svg","scope":"global","command":"(async () => {\n  const actor = canvas.tokens.controlled[0]?.actor ?? game.user.character;\n  if (!actor) { ui.notifications.warn(\"Select a token or assign a character to your user.\"); return; }\n  if (typeof game.traaash?.rollCompanyMotivation !== \"function\") {\n    ui.notifications.error(\"fvtt_mosh_1e_traaash module not loaded.\");\n    return;\n  }\n  await game.traaash.rollCompanyMotivation(actor);\n})();","folder":null,"sort":0,"ownership":{"default":3},"flags":{},"_stats":{"systemId":"mosh","systemVersion":"0.4.0","coreVersion":"11.308","createdTime":1685936572185,"modifiedTime":1693515520278,"lastModifiedBy":"6EeM38DJkcBWNAmw"}}
{"_id": "TrMacYps14Term01", "name": "Ypsilon 14 — Terminal", "type": "script", "author": "6EeM38DJkcBWNAmw", "img": "icons/svg/book.svg", "scope": "global", "command": "(async () => {\n  const PACK_ID = \"fvtt_mosh_1e_traaash.journals_ypsilon14_1e\";\n  const screens = [[\"Yps14MainScreen1\", \"MAIN SCREEN\"], [\"Yps14DiagMenu01X\", \"DIAGNOSTICS\"], [\"Yps14LayoutImg01\", \"STATION LAYOUT\"], [\"Yps14StatusWarn1\", \"SYSTEM STATUS\"], [\"Yps14ScheduleL01\", \"SCHEDULE\"], [\"Yps14RosterLst01\", \"ROSTER\"], [\"Yps14CtrlMenu01X\", \"CONTROLS\"], [\"Yps14AirlockL01X\", \"AIRLOCKS\"], [\"Yps14ShowerOff01\", \"SHOWERS\"], [\"Yps14SysLocked01\", \"SYSTEM (LOCKED)\"], [\"Yps14SysGrantd01\", \"SYSTEM (UNLOCKED)\"], [\"Yps14LifeSupp01X\", \"LIFE SUPPORT\"], [\"Yps14ScuttleS01X\", \"SCUTTLE\"], [\"Yps14CommsShip01\", \"COMMS\"]];\n  const opts = screens.map(([id, label]) => `<option value=\"${id}\">${label}</option>`).join(\"\");\n  new Dialog({\n    title: \"Ypsilon 14 Terminal\",\n    content: `<div style=\"background:#030e03;color:#33dd22;font-family:'Courier New',monospace;padding:1rem;border:1px solid #1a4a1a;margin-bottom:4px\">\n      <div style=\"margin-bottom:8px;letter-spacing:1px\">YPSILON 14 CONTROL TERMINAL</div>\n      <select name=\"screen\" style=\"width:100%;background:#030e03;color:#33dd22;font-family:inherit;border:1px solid #1a4a1a;padding:4px\">${opts}</select>\n    </div>`,\n    buttons: {\n      show: {\n        label: \"Show Players\",\n        callback: async html => {\n          const id = html.find(\"[name='screen']\").val();\n          const pack = game.packs.get(PACK_ID);\n          const doc = await pack.getDocument(id);\n          doc.show();\n        }\n      },\n      gm: {\n        label: \"GM View\",\n        callback: async html => {\n          const id = html.find(\"[name='screen']\").val();\n          const pack = game.packs.get(PACK_ID);\n          const doc = await pack.getDocument(id);\n          doc.sheet.render(true);\n        }\n      },\n      cancel: { label: \"Cancel\" }\n    },\n    default: \"show\"\n  }).render(true);\n})();", "folder": null, "sort": 200, "ownership": {"default": 0, "6EeM38DJkcBWNAmw": 3}, "flags": {}, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1730000000000, "modifiedTime": 1730000000000, "lastModifiedBy": "6EeM38DJkcBWNAmw"}}
