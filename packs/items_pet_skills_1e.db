{"_id": "Ex1CompanionTrng", "name": "Companion Training", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to be a comforting, helpful companion animal. Prerequisite: Calm Under Fire.</p>", "rank": "Expert", "bonus": 15, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Tr1CalmUndrFire0"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ex2MilitaryTrng0", "name": "Military Training", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Very disciplined. Trained to military standards to attack, subdue, and guard. Can also be reached via Calm Under Fire or Tracking.</p>", "rank": "Expert", "bonus": 15, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Tr2ToothAndClaw0"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ex3HuntingPet000", "name": "Hunting", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to track and kill prey. Prerequisite: Tracking (also reachable via Tooth & Claw).</p>", "rank": "Expert", "bonus": 15, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Tr3TrackingPet00"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ex4DetectPet0000", "name": "Detect", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to detect and alert owner to the presence of substances when given a sample. Prerequisite: Tracking (also reachable via Foraging or Rimwise).</p>", "rank": "Expert", "bonus": 15, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Tr3TrackingPet00"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ex5ZeroGTraining", "name": "Zero-G Training", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to move nimbly in microgravity. Prerequisite: Athletics (also reachable via Safety).</p>", "rank": "Expert", "bonus": 15, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Tr7AthleticsPet0"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ms1PanicTraining", "name": "Panic Training", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to calm down a panicking person with contact and pressure. Prerequisite: Companion Training.</p>", "rank": "Master", "bonus": 20, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Ex1CompanionTrng"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ms2XenoTracking0", "name": "Xeno Tracking", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to track certain kinds of alien creatures. Does not require a sample. Note the type of alien creature it is trained to track. Prerequisite: Military Training.</p>", "rank": "Master", "bonus": 20, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Ex2MilitaryTrng0"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ms3SearchRescue0", "name": "Search & Rescue", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to find people buried under rubble and in other disaster scenarios, and to alert others to their presence. Does not require a sample. Prerequisite: Hunting (also reachable via Detect).</p>", "rank": "Master", "bonus": 20, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Ex3HuntingPet000"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ms4DetectSubst00", "name": "Detect Substance", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to detect and alert owner to the presence of a specific substance. Does not require a sample. Note the substance it is trained to detect. Prerequisite: Detect.</p>", "rank": "Master", "bonus": 20, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Ex4DetectPet0000"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}
{"_id": "Ms5DetectDisease", "name": "Detect Disease", "type": "skill", "img": "icons/svg/item-bag.svg", "system": {"description": "<p>Trained to detect and alert owner that someone is infected with a specific disease. Does not require a sample. Note the disease it is trained to detect. Prerequisite: Detect.</p>", "rank": "Master", "bonus": 20, "prerequisite_ids": ["Compendium.fvtt_mosh_1e_traaash.items_pet_skills_1e.Item.Ex4DetectPet0000"]}, "effects": [], "flags": {}, "folder": null, "sort": 0, "_stats": {"systemId": "mosh", "systemVersion": "0.4.0", "coreVersion": "11.308", "createdTime": 1750000000000, "modifiedTime": 1750000000000, "lastModifiedBy": "mechanoid23"}}